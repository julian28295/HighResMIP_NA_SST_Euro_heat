   "source": [
    "lhf_oa = xr.open_dataset('/work/bm1398/m301111/Observations/OA_Flux/lh_oaflux_1985-2018.nc')\n",
    "lhf_era5 = xr.open_dataset('/work/bm1398/m301111/Reanalysis/ERA5/daily/ERA5__surface_latent_heat_flux__1979-2019.nc')"
   ]
  },
  {
   "cell_type": "code",
